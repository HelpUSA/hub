{
  "outputDirectory": "build",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "master": true
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://helpus-site-production-334b.up.railway.app/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
